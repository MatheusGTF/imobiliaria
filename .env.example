# ─── Banco de dados (PostgreSQL) ─────────────────────────────────────────────
# Em produção (Vercel + Neon) essas duas variáveis são criadas automaticamente
# pela integração. Localmente, aponte para o seu Postgres.
POSTGRES_PRISMA_URL="postgresql://usuario:senha@localhost:5432/imobiliaria"
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@localhost:5432/imobiliaria"

# ─── Sessão do painel ────────────────────────────────────────────────────────
# Valor aleatório e secreto. Gere um novo:  openssl rand -base64 32
# (também protege os segredos do autenticador — não troque depois sem avisar)
AUTH_SECRET="gere-um-valor-aleatorio-aqui"

# ─── Primeiro administrador (usado só por `npm run seed`) ────────────────────
# Obrigatórios. A senha precisa ter pelo menos 12 caracteres.
SEED_ADMIN_EMAIL="seu-email@exemplo.com"
SEED_ADMIN_PASSWORD=""

# Nome, logo, telefones, WhatsApp, Instagram e endereço do portal são
# configurados em Configurações no /admin (não por variável de ambiente).
# O armazenamento de fotos (Vercel Blob) é conectado pela Vercel (BLOB_*).
