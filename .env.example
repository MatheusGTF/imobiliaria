# ─── Desenvolvimento local (SQLite, zero configuração) ───────────────────────
DATABASE_URL="file:./dev.db"
AUTH_SECRET="gere-um-valor-aleatorio-aqui"

# Nome, logo, telefones, WhatsApp, Instagram e endereço do portal são
# configurados em Configurações no /admin (não por variável de ambiente).

# Usados apenas pelo script de seed (npm run seed)
SEED_ADMIN_EMAIL="admin@imobiliaria.com"
SEED_ADMIN_PASSWORD="admin123"

# ─── Produção (Vercel) — ver DEPLOY.md ───────────────────────────────────────
# DATABASE_URL       = connection string do Postgres (Neon) — pooled
# DIRECT_URL         = connection string do Postgres (Neon) — direct (migrations)
# AUTH_SECRET        = valor aleatório novo (openssl rand -base64 32)
# AUTH_URL           = https://aguaclaraimoveis.com.br
# BLOB_READ_WRITE_TOKEN = token do Vercel Blob (criado no painel da Vercel)
